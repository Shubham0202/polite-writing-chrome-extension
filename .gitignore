.env
.env.*
!.env.example

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Caches and test coverage
.vite/
.eslintcache
coverage/

# Editors and OS
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.suo
.DS_Store
Thumbs.db

